<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>io.github.maevarodrigues</groupId>
	<artifactId>quizapp</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>quizapp</name>
	<description>API REST de quiz (superstitions et phobies étranges) avec Spring Boot</description>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<java.version>21</java.version>
		<!-- Versions non gérées par Spring Boot : fixées ici. -->
		<archunit.version>1.5.1</archunit.version>
		<testcontainers-jooq-codegen-maven-plugin.version>0.0.4</testcontainers-jooq-codegen-maven-plugin.version>
		<!-- Testcontainers 1.x, utilisé UNIQUEMENT par le plugin de génération jOOQ (classpath isolé) :
		     le plugin n'est pas compatible avec les artefacts renommés de Testcontainers 2. -->
		<testcontainers-codegen.version>1.21.4</testcontainers-codegen.version>
		<jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
		<sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
		<!-- Rempli par JaCoCo (agent de couverture) ; vide par défaut pour que @{argLine} soit toujours défini. -->
		<argLine/>
		<!-- Analyse SonarCloud (lancée par la CI) : le token est fourni par la variable d'environnement SONAR_TOKEN. -->
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.organization>maeva-rodrigues</sonar.organization>
		<sonar.projectKey>Maeva-RODRIGUES_quizapp</sonar.projectKey>
		<!-- Code généré par jOOQ : ce n'est pas notre code, ni à analyser ni à compter dans la couverture. -->
		<sonar.exclusions>**/adapters/out/persistence/jooq/**</sonar.exclusions>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-batch-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jooq</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Démarre compose.yaml au lancement de l'application en local. Optionnel :
		     absent du jar de production. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jooq-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Génération du code jOOQ (phase generate-sources) : démarre un PostgreSQL éphémère,
			     y applique les changelogs Liquibase, puis génère les classes Java depuis le schéma obtenu.
			     Le code généré va dans target/ : il n'est pas versionné, il est recréé à chaque build. -->
			<plugin>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
				<version>${testcontainers-jooq-codegen-maven-plugin.version}</version>
				<dependencies>
					<!-- Le plugin (2024) embarque d'anciennes versions : on impose celles du projet. -->
					<dependency>
						<groupId>org.jooq</groupId>
						<artifactId>jooq-codegen</artifactId>
						<version>${jooq.version}</version>
					</dependency>
					<dependency>
						<groupId>org.liquibase</groupId>
						<artifactId>liquibase-core</artifactId>
						<version>${liquibase.version}</version>
					</dependency>
					<dependency>
						<groupId>org.postgresql</groupId>
						<artifactId>postgresql</artifactId>
						<version>${postgresql.version}</version>
					</dependency>
					<dependency>
						<groupId>org.testcontainers</groupId>
						<artifactId>testcontainers</artifactId>
						<version>${testcontainers-codegen.version}</version>
					</dependency>
					<dependency>
						<groupId>org.testcontainers</groupId>
						<artifactId>postgresql</artifactId>
						<version>${testcontainers-codegen.version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>generate-jooq-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<database>
								<type>POSTGRES</type>
								<containerImage>postgres:18</containerImage>
							</database>
							<liquibase>
								<changeLogDirectory>src/main/resources</changeLogDirectory>
								<changeLogPath>db/changelog/db.changelog-master.yaml</changeLogPath>
							</liquibase>
							<jooq>
								<generator>
									<database>
										<inputSchema>public</inputSchema>
										<includes>.*</includes>
										<!-- Tables techniques de Liquibase : pas de code à générer. -->
										<excludes>databasechangelog|databasechangeloglock|batch_.*</excludes>
									</database>
									<target>
										<packageName>io.github.maevarodrigues.quizapp.adapters.out.persistence.jooq</packageName>
										<directory>target/generated-sources/jooq</directory>
									</target>
								</generator>
							</jooq>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Expose le chemin du jar de chaque dépendance en propriété Maven
			     (ex. ${org.mockito:mockito-core:jar}), utilisée par Surefire ci-dessous. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Charge l'agent Mockito au démarrage de la JVM de test : le chargement dynamique
			     d'agents sera interdit par défaut dans une future version du JDK. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- @{argLine} (évalué tard) garde l'agent JaCoCo ajouté par prepare-agent. -->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
			<!-- Tests d'intégration (classes *IT) : lancés par `./mvnw verify`, après les tests unitaires
			     (Surefire, classes *Test). Un échec fait échouer le build à la phase verify. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Couverture de tests : un seul fichier jacoco.exec, alimenté par les tests unitaires ET d'intégration
			     (même argLine), puis rapport HTML + XML (lu par SonarCloud) dans target/site/jacoco. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-maven-plugin.version}</version>
				<configuration>
					<excludes>
						<exclude>io/github/maevarodrigues/quizapp/adapters/out/persistence/jooq/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<!-- Phase verify : après les tests d'intégration (phase integration-test). -->
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!-- Version figée pour que `./mvnw sonar:sonar` soit reproductible. -->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
